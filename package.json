{
  "name": "fenix-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "server",
    "shared",
    "web"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.server.json"
  },
  "dependencies": {
    "@fastify/static": "^8",
    "fastify": "^5",
    "ssh2": "^1.16",
    "ws": "^8",
    "yaml": "^2",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8",
    "typescript": "^5.7",
    "vitest": "^3"
  }
}
